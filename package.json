{
  "name": "dsh-tui-app",
  "version": "0.1.0",
  "description": "Out-of-tree full-screen Ink app bundle for DeepSeek Harness",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "INSTALL.md",
    "PROVENANCE.md",
    "scripts/install-default-command.ps1",
    "NOTICE",
    "LICENSE"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "npm run logo:generate && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "logo:generate": "node scripts/generate-logo.mjs",
    "test": "vitest run",
    "test:m1": "vitest run tests/m1",
    "test:m2": "vitest run tests/m2",
    "test:m3": "vitest run tests/m3",
    "test:m4": "vitest run tests/m4",
    "test:ac": "node scripts/ac1.mjs && node scripts/ac2.mjs",
    "test:ac:m2": "vitest run tests/m2 && node scripts/ac3.mjs",
    "test:ac:m3": "vitest run tests/m3 && node scripts/ac4.mjs && node scripts/ac5.mjs",
    "test:ac:m4": "vitest run tests/m4 tests/m2/cjk-markdown.spec.ts tests/m2/property.spec.ts && node scripts/ac6.mjs && node scripts/ac7.mjs",
    "test:pty:m4": "node scripts/m4-pty.mjs",
    "test:ask-user": "node scripts/ask-user-e2e.mjs",
    "test:default-command": "node scripts/default-command-pty.mjs",
    "test:ac:all": "npm run test:ac && npm run test:ac:m2 && npm run test:ac:m3 && npm run test:ac:m4 && npm run test:pty:m4"
  },
  "dependencies": {
    "@deepseek-ai/dsh-cmdline": "0.1.0-rc.6",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-agent-default-model": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "commander": "15.0.0",
    "ink": "7.1.1",
    "marked": "18.0.7",
    "react": "19.2.8",
    "string-width": "8.2.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "fast-check": "4.9.0",
    "node-pty": "1.1.0",
    "react-test-renderer": "19.2.8",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}

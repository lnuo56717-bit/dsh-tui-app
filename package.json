{
  "name": "dsh-tui-app",
  "version": "0.1.0-m1",
  "description": "Out-of-tree full-screen Ink app bundle for DeepSeek Harness",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "NOTICE"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "npm run logo:generate && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "logo:generate": "node scripts/generate-logo.mjs",
    "test": "vitest run",
    "test:m1": "vitest run tests/m1",
    "test:ac": "node scripts/ac1.mjs && node scripts/ac2.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-cmdline": "0.1.0-rc.6",
    "commander": "15.0.0",
    "ink": "7.1.1",
    "react": "19.2.8"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "node-pty": "1.1.0",
    "react-test-renderer": "19.2.8",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
